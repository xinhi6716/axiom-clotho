include README.zh-TW.md
include CHANGELOG.md CONTRIBUTING.md ROADMAP.md SECURITY.md
recursive-include docs *.md *.svg
recursive-include examples *.py *.csv *.json *.md
recursive-include tests *.py

# Keep the unit-equivalence illustration and its reference checksums in source archives.
include examples/numeric-unit-equivalence/assets/unit-equivalence.svg
include examples/numeric-unit-equivalence/reference/SHA256SUMS

# Offline maintainer version-table check, also used by its source tests.
include tools/check_doc_versions.py tools/doc_version_contract.json

# Optional Rust source and its no-download parity check; never include target/.
include tools/check_rust_parity.py
include rust/Cargo.toml rust/Cargo.lock rust/clotho-core/Cargo.toml
recursive-include rust/clotho-core/src *.rs
recursive-include rust/clotho-core/tests *.rs

# Read-only synthetic preflight timing; included for reproducible source checks.
include benchmarks/prediction_preflight.py
include benchmarks/prediction_preflight/reference/timings.json

# Optional native package sources, without compiler output or binary modules.
include native/numeric-support/Cargo.toml native/numeric-support/Cargo.lock
include native/numeric-support/pyproject.toml native/numeric-support/README.md native/numeric-support/LICENSE
recursive-include native/numeric-support/src *.rs
recursive-include native/numeric-support/python *.py
recursive-include native/numeric-support/tests *.py

# Explicit optional numeric-backend benchmark and host-specific reference.
include benchmarks/native_numeric_support.py
include benchmarks/native_numeric_support/reference/timings.json
